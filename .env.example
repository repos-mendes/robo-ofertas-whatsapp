# ---------------------------------------------------------------------------
# Copie este arquivo para .env e preencha. O .env está no .gitignore.
# ---------------------------------------------------------------------------

# --- Planilha de ofertas curadas (web app do Apps Script) ---
# URL /exec da implantação (Extensões > Apps Script > Implantar > App da web)
# e o token definido na constante TOKEN de scripts/planilha-webapp.gs.
SHEET_WEBAPP_URL=
SHEET_WEBAPP_TOKEN=

# --- WhatsApp ---
# JID do grupo, no formato 1234567890-1234567890@g.us
# Descubra rodando: npm run wa:groups
WA_GROUP_JID=

# --- Camada HTTP local ---
HTTP_PORT=8787
# Token exigido no header x-api-token. Gere um valor aleatório qualquer.
HTTP_TOKEN=

# --- Operação ---
# true = não envia nada ao WhatsApp, só imprime a mensagem no console.
# Deixe true até validar o pipeline inteiro.
DRY_RUN=true
LOG_LEVEL=info

# --- Mercado Livre (fluxo antigo via API; dormente, pode deixar em branco) ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
